{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wellnest-assessment",
  "account_id": "f7d270c033269eb91a14318e08bf0a74",
  "main": "worker.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/pay", "/health", "/ready", "/docs", "/openapi.json"]
  },
  "services": [{ "binding": "BACKEND", "service": "wellnest-backend" }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
  }
}
