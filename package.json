{
  "name": "wellnest-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "npm run contract:check && tsc --noEmit && vite build",
    "test": "playwright test --project=desktop",
    "test:e2e": "playwright test",
    "contract:sync": "node scripts/sync-contract.mjs",
    "contract:check": "node scripts/sync-contract.mjs --check",
    "test:contract": "playwright test --project=desktop e2e/i18n.spec.ts --grep \"服务端各行动规则|中英文文案目录\""
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.8",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
